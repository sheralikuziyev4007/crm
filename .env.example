# Base URL of the REST API.
# With the mock API on (default), these requests are answered by Mock Service Worker in the browser.
VITE_API_URL=/api

# The mock API is enabled unless this is "false".
# Set it to "false" and point VITE_API_URL at a real backend to switch over; the mock code is then not built.
VITE_ENABLE_MOCKS=true
